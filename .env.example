# Copy this file to .env and update it for your local PostgreSQL instance.
# Never commit .env or real database credentials.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_inspections
DB_USER=postgres
DB_PASSWORD=change-me
# Optional for the API only (ETL uses DB_* variables):
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/food_inspections

# Comma-separated approved frontend origins for API CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Maximum number of newest Socrata records fetched per run
ETL_LIMIT=50000
